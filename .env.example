# Configure these in your hosting provider; do not commit actual secrets.
PORT=8002
# WhatsApp credentials and bot settings are stored locally by default.
# Use a persistent volume/path on Railway, Render, or Pterodactyl.
DATA_DIR=./data
# Optional shared storage backend for multi-instance deployments.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-sb_secret_key
# Optional display and owner configuration
BOT_NAME=Red Mini
IMAGE_THEME=Redragon
# Set only if you want an instance-wide owner with elevated commands.
OWNER_NUMBER=
NEWSLETTER_JID=120363427119111004@newsletter
# Channels automatically followed by each connected WhatsApp session.
AUTO_FOLLOW_NEWSLETTERS=120363409714698622@newsletter,120363422266851455@newsletter,120363331321673219@newsletter,120363410850886536@newsletter,120363388565127379@newsletter
OPENWEATHER_API_KEY=
TMDB_API_KEY=
